for y = 0, 195 do
   local sourceY = math.floor(y * 96 / 196) + 1
   for x = 0, 195 do
      local sourceX = math.floor(x * 96 / 196) + 1
      SetTile(GoldRushSourceTiles[sourceY][sourceX], x, y, 0)
   end
end
GoldRushSourceTiles = nil

