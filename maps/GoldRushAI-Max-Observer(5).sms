AddTrigger(function() return GameCycle > 0 end, function()
   SetDiplomacy(0, "enemy", 1)
   SetDiplomacy(1, "enemy", 0)
   SetDiplomacy(0, "enemy", 2)
   SetDiplomacy(2, "enemy", 0)
   SetDiplomacy(0, "enemy", 3)
   SetDiplomacy(3, "enemy", 0)
   SetDiplomacy(1, "enemy", 2)
   SetDiplomacy(2, "enemy", 1)
   SetDiplomacy(1, "enemy", 3)
   SetDiplomacy(3, "enemy", 1)
   SetDiplomacy(2, "enemy", 3)
   SetDiplomacy(3, "enemy", 2)
   SetDiplomacy(0, "neutral", 4)
   SetDiplomacy(4, "neutral", 0)
   SetDiplomacy(1, "neutral", 4)
   SetDiplomacy(4, "neutral", 1)
   SetDiplomacy(2, "neutral", 4)
   SetDiplomacy(4, "neutral", 2)
   SetDiplomacy(3, "neutral", 4)
   SetDiplomacy(4, "neutral", 3)
   RevealMap("explored")
   SetFogOfWar(false)
   return false
end)




